    "changelog": [
        {
            "version": "1.0.1",
            "date": "2026-10-18",
            "notes": "Matches the reference more closely: even product card images, banner second lines, Tempo's own phone header with the benefits bar, empty cart layout, product details table, collapsed filters and row arrows only when a row scrolls."
        },
        {
            "version": "1.0.0",
            "date": "2026-10-17",
            "notes": "Tempo reference theme with platform commerce, extension placements, responsive layouts and customizer support."
        }
