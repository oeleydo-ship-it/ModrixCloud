{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "modrixcommerce/tempo",
    "display_name": "Tempo Outlet",
    "description": "Responsive Tempo outlet storefront matching the MagicPath reference, with campaigns, catalog filters, product variants, a live cart, checkout, extension slots and full customizer controls.",
    "version": "1.0.1",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "capabilities": [
        "home.sections",
        "demo_content"
    ],
    "assets": "assets",
    "screenshot": "assets/demo-preview.png",
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#171717",
        "color.primary": "#ffd000",
        "color.primary_foreground": "#111111",
        "color.muted": "#f6f6f6",
        "color.muted_foreground": "#666666",
        "color.accent": "#8e0615",
        "color.accent_foreground": "#f6e9c3",
        "color.border": "#ececef",
        "font_body": "serif",
        "font_heading": "serif",
        "radius": "0",
        "density": "compact",
        "container": "wide",
        "layout.header": "classic",
        "layout.footer": "columns",
        "layout.product_card": "minimal",
        "layout.grid_columns": "4",
        "layout.product_page": "split",
        "menu_1_label": "New arrivals",
        "menu_1_link": "/search?sort=newest",
        "menu_2_label": "Men",
        "menu_2_link": "/search?q=Men",
        "menu_3_label": "Women",
        "menu_3_link": "/search?q=Women",
        "menu_4_label": "Kids",
        "menu_4_link": "/search?q=Kids",
        "menu_5_label": "Toys",
        "menu_5_link": "/search?q=Toys",
        "menu_6_label": "Sportswear",
        "menu_6_link": "/search?q=Sportswear",
        "menu_7_label": "Beauty",
        "menu_7_link": "/search?q=Beauty",
        "menu_8_label": "Home & living",
        "menu_8_link": "/search?q=Home%20living",
        "menu_9_label": "Brands",
        "menu_9_link": "/search?q=Brands",
        "footer_1_title": "Let us help you",
        "footer_1_1_label": "My orders",
        "footer_1_1_link": "/account/orders",
        "footer_1_2_label": "My account",
        "footer_1_2_link": "/account",
        "footer_1_3_label": "Shopping bag",
        "footer_1_3_link": "/cart",
        "footer_2_title": "Who we are",
        "footer_2_1_label": "New arrivals",
        "footer_2_1_link": "/search?sort=newest",
