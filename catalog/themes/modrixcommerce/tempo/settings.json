{
    "title": "Tempo design",
    "description": "Reference-matched outlet theme. Edit every campaign and tile in Homepage sections; manage shared menu links in Navigation. Newsletter uses the optional Newsletter extension.",
    "fields": {
        "custom.brand": {
            "type": "string",
            "label": "Wordmark",
            "group": "Header",
            "tab": "header",
            "default": "Tempo",
            "max": 60
        },
        "custom.logo_image": {
            "type": "image",
            "label": "Logo image",
            "group": "Header",
            "tab": "header",
            "default": ""
        },
        "custom.search_placeholder": {
            "type": "string",
            "label": "Search placeholder",
            "group": "Header",
            "tab": "header",
            "default": "Search for items or brands",
            "max": 160
        },
        "custom.sticky_header": {
            "type": "boolean",
            "label": "Sticky header (replaces Tempo's header on phones and tablets)",
            "group": "Header",
            "tab": "header",
            "default": false
        },
        "custom.show_benefits": {
            "type": "boolean",
            "label": "Show benefits bar",
            "group": "Header",
            "tab": "header",
            "default": true
        },
        "custom.benefits": {
            "type": "string",
            "label": "Benefits bar",
            "group": "Header",
            "tab": "header",
            "default": "Discover new arrivals  |  Shop your favourites  |  Secure checkout",
            "max": 160
        },
        "custom.featured_label": {
            "type": "string",
            "label": "Featured navigation label",
            "group": "Header",
            "tab": "header",
            "default": "Special prices",
            "max": 160
        },
        "custom.featured_link": {
            "type": "link",
            "label": "Featured navigation link",
            "group": "Header",
            "tab": "header",
            "default": "/search?sort=price_asc"
        },
        "custom.nav_background": {
            "type": "color",
            "label": "Navigation background",
            "group": "Header",
            "tab": "header",
            "default": "#050505"
        },
        "custom.nav_foreground": {
            "type": "color",
            "label": "Navigation text",
            "group": "Header",
            "tab": "header",
            "default": "#ffffff"
        },
        "custom.feature_background": {
            "type": "color",
            "label": "Featured link background",
            "group": "Header",
            "tab": "header",
            "default": "#ef1321"
        },
        "custom.feature_foreground": {
            "type": "color",
            "label": "Featured link text",
            "group": "Header",
            "tab": "header",
            "default": "#ffffff"
        },
        "custom.page_width": {
            "type": "integer",
            "label": "Content width",
            "group": "Homepage layout",
            "tab": "home",
            "default": 1280,
            "min": 960,
            "max": 1800
        },
        "custom.section_gap": {
            "type": "integer",
            "label": "Homepage spacing",
            "group": "Homepage layout",
            "tab": "home",
            "default": 26,
            "min": 12,
            "max": 80
        },
        "custom.hero_height": {
            "type": "integer",
            "label": "Desktop hero height",
            "group": "Homepage layout",
            "tab": "home",
            "default": 360,
            "min": 280,
            "max": 800
        },
        "custom.hero_mobile_height": {
            "type": "integer",
            "label": "Mobile hero height",
            "group": "Homepage layout",
            "tab": "home",
            "default": 300,
            "min": 260,
            "max": 650
        },
        "custom.hero_title_size": {
            "type": "integer",
            "label": "Desktop title size",
            "group": "Homepage layout",
            "tab": "home",
            "default": 56,
            "min": 28,
            "max": 90
