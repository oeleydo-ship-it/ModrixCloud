        "custom.hero_overlay": {
            "type": "integer",
            "label": "Image shade (%)",
            "group": "Homepage layout",
            "tab": "home",
            "default": 15,
            "min": 0,
            "max": 70
        },
        "custom.hero_eyebrow": {
            "type": "string",
