{
    "name": "Baby campaign and categories",
    "settings": [
        {
            "type": "header",
            "content": "Sidebar"
        },
        {
            "type": "select",
            "id": "sidebar_source",
            "label": "Sidebar list shows",
            "options": [
                {
                    "value": "tags",
                    "label": "Product tags"
                },
                {
                    "value": "links",
                    "label": "Sidebar category blocks"
                }
            ],
            "default": "tags",
            "info": "Product tags link to the tag's products. If the store has no tags yet, the sidebar category blocks are shown."
        },
        {
            "type": "tags",
            "id": "sidebar_tags",
            "label": "Sidebar tags",
            "limit": 10,
            "fallback": "popular",
            "info": "Leave empty to show the most-used tags."
        },
        {
            "type": "text",
            "id": "eyebrow",
            "label": "Eyebrow",
            "default": "LITTLE DAYS, LOVELY MOMENTS"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Keep your little one close"
        },
        {
            "type": "range",
            "id": "heading_size",
            "label": "Heading size",
            "min": 22,
            "max": 48,
            "step": 1,
            "default": 32
        },
        {
            "type": "textarea",
            "id": "body",
            "label": "Supporting text",
            "default": "Soft everyday essentials for the moments that matter."
        },
        {
            "type": "image",
            "id": "image",
            "label": "Main campaign image",
            "default": "asset:assets/hero-carrier.webp"
        },
        {
            "type": "text",
            "id": "button",
            "label": "Button label",
            "default": "Shop now"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Main destination",
            "default": "/search"
        },
        {
            "type": "text",
            "id": "bottom_eyebrow",
            "label": "Lower campaign eyebrow",
            "default": "A LITTLE ROOM TO GROW"
        },
        {
            "type": "text",
            "id": "bottom_heading",
            "label": "Lower campaign heading",
            "default": "Comfort for every little day"
        },
        {
            "type": "text",
            "id": "bottom_body",
            "label": "Lower campaign text",
            "default": "Discover nursery favourites"
        },
        {
            "type": "image",
            "id": "bottom_image",
            "label": "Lower campaign image",
            "default": "asset:assets/rocker.webp"
        },
        {
            "type": "text",
            "id": "bottom_button",
            "label": "Lower button label",
            "default": "Explore nursery"
        },
        {
            "type": "url",
            "id": "bottom_link",
            "label": "Lower destination",
            "default": "/search"
        },
        {
            "type": "color",
            "id": "bottom_background",
            "label": "Lower background",
            "default": "#f2f4f3"
        }
    ],
    "blocks": [
        {
            "type": "category",
            "name": "Sidebar category",
            "settings": [
                {
                    "type": "text",
                    "id": "label",
                    "label": "Label",
                    "default": ""
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Destination",
                    "default": "/search"
                },
                {
                    "type": "select",
                    "id": "icon",
                    "label": "Icon",
                    "options": [
                        {
                            "value": "bath",
                            "label": "bath"
                        },
                        {
                            "value": "baby",
                            "label": "baby"
                        },
                        {
                            "value": "moon",
                            "label": "moon"
                        },
                        {
                            "value": "shirt",
                            "label": "shirt"
                        },
                        {
                            "value": "milk",
                            "label": "milk"
                        },
                        {
                            "value": "toy",
                            "label": "toy"
                        },
                        {
                            "value": "home",
                            "label": "home"
                        },
                        {
                            "value": "heart",
                            "label": "heart"
                        },
                        {
                            "value": "star",
                            "label": "star"
                        }
                    ],
                    "default": "baby"
                }
            ]
        },
        {
            "type": "promotion",
            "name": "Side campaign",
            "settings": [
                {
                    "type": "text",
                    "id": "eyebrow",
                    "label": "Eyebrow",
                    "default": "LITTLE FAVOURITES"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Everyday baby care"
                },
                {
                    "type": "textarea",
                    "id": "body",
                    "label": "Supporting text",
                    "default": "Thoughtful little essentials"
                },
                {
                    "type": "image",
                    "id": "image",
                    "label": "Image",
                    "default": "asset:assets/wash.webp"
                },
                {
                    "type": "text",
                    "id": "button",
                    "label": "Button label",
                    "default": "Shop now"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Destination",
                    "default": "/search"
                },
                {
                    "type": "color",
                    "id": "background",
                    "label": "Background",
                    "default": "#f8f7f3"
                }
            ]
        }
    ],
    "max_blocks": 10,
    "presets": [
        {
            "name": "Baby campaign and categories"
        }
    ],
    "enabled_on": {
        "templates": ["*"]
    }
}
