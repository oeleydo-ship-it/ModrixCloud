                {
                    "type": "text",
                    "id": "label",
                    "label": "Label",
                    "default": ""
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Destination",
                    "default": "/search"
                }
            ]
        },
        {
            "type": "social",
            "name": "Social link",
            "settings": [
                {
                    "type": "text",
                    "id": "label",
                    "label": "Network name",
                    "default": ""
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Profile URL",
                    "default": "https://www.instagram.com/"
                }
            ]
        },
        {
            "type": "payment",
            "name": "Payment label",
            "settings": [
                {
                    "type": "text",
                    "id": "label",
                    "label": "Label",
                    "default": ""
                },
                {
                    "type": "image",
                    "id": "image",
                    "label": "Payment logo"
                }
