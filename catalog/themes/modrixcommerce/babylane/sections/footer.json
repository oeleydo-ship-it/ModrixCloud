{
    "name": "Footer",
    "settings": [
        {
            "type": "select",
            "id": "menu_source",
            "label": "Footer menus",
            "options": [
                {
                    "value": "auto",
                    "label": "Admin → Navigation once saved, else theme links"
                },
                {
                    "value": "store",
                    "label": "Always Admin → Navigation"
                },
                {
                    "value": "theme",
                    "label": "Theme links only"
                }
            ],
            "default": "auto"
        },
        {
            "type": "text",
            "id": "newsletter_heading",
            "label": "Newsletter heading",
            "default": "Newsletter"
        },
        {
            "type": "text",
            "id": "newsletter_body",
            "label": "Newsletter text",
            "default": "New arrivals and little favourites, straight to your inbox."
        },
        {
            "type": "text",
            "id": "copyright",
            "label": "Copyright",
            "default": "Baby Lane. All rights reserved."
        },
        {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#f8f8f8"
        },
        {
            "type": "color",
            "id": "foreground",
            "label": "Headings and text",
            "default": "#222222"
        },
        {
            "type": "color",
            "id": "muted",
            "label": "Secondary text",
            "default": "#777777"
        }
    ],
    "blocks": [
        {
            "type": "link",
            "name": "Footer link",
            "settings": [
                {
                    "type": "text",
                    "id": "group",
                    "label": "Column heading",
