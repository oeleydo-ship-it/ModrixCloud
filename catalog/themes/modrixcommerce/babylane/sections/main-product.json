{
    "name": "Product information",
    "settings": [
        {
            "type": "text",
            "id": "add_label",
            "label": "Add to cart label",
            "default": "Add to cart"
        },
        {
            "type": "text",
            "id": "buy_label",
            "label": "Buy now label",
            "default": "Buy now"
        },
        {
            "type": "text",
            "id": "description_label",
            "label": "Description tab label",
            "default": "Description"
        },
        {
            "type": "text",
            "id": "specifications_label",
            "label": "Specifications tab label",
            "default": "Specifications"
        },
        {
            "type": "text",
            "id": "delivery_label",
            "label": "Delivery tab label",
            "default": "Delivery & returns"
        },
        {
            "type": "textarea",
            "id": "delivery_text",
            "label": "Delivery and returns information",
            "default": "Delivery charges and available services are shown at checkout. Review the store’s published return policy before placing an order."
        },
        {
            "type": "text",
            "id": "related_heading",
            "label": "Related product heading",
            "default": "Related products"
        },
        {
            "type": "checkbox",
            "id": "show_service_rail",
            "label": "Show service rail",
            "default": true
        },
        {
            "type": "image",
            "id": "promo_image",
            "label": "Sidebar campaign image",
            "default": "asset:assets/bottles.webp"
        },
        {
            "type": "text",
            "id": "promo_heading",
            "label": "Sidebar campaign heading",
            "default": "Little feeding favourites"
        },
        {
            "type": "url",
            "id": "promo_link",
            "label": "Sidebar campaign destination",
            "default": "/search"
        }
