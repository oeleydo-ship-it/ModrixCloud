    "blocks": [
        {
            "type": "benefit",
            "name": "Service",
            "settings": [
                {
                    "type": "select",
                    "id": "icon",
                    "label": "Icon",
                    "options": [
                        {
                            "value": "delivery",
                            "label": "delivery"
                        },
                        {
                            "value": "returns",
                            "label": "returns"
                        },
                        {
                            "value": "payment",
                            "label": "payment"
                        },
                        {
                            "value": "support",
                            "label": "support"
                        },
                        {
                            "value": "gift",
                            "label": "gift"
                        }
                    ],
                    "default": "delivery"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Text",
                    "default": "Delivery options at checkout"
                }
            ]
        }
