            "label": "QR image description",
            "default": "Store information"
        },
        {
            "type": "text",
            "id": "app_heading",
            "label": "App link heading",
            "default": "Download our app"
        },
        {
            "type": "url",
            "id": "appstore_url",
            "label": "App Store URL"
        },
        {
            "type": "text",
            "id": "appstore_label",
            "label": "App Store label",
            "default": "App Store"
        },
        {
            "type": "url",
            "id": "playstore_url",
            "label": "Google Play URL"
        },
        {
            "type": "text",
            "id": "playstore_label",
            "label": "Google Play label",
            "default": "Google Play"
        }
    ],
    "blocks": [
        {
            "type": "link",
            "name": "Footer link",
            "settings": [
                {
                    "type": "text",
                    "id": "group",
                    "label": "Column heading",
                    "default": "Quick links"
                },
                {
                    "type": "text",
                    "id": "label",
                    "label": "Label",
                    "default": ""
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Destination",
                    "default": "/search"
                }
            ]
        },
        {
            "type": "social",
            "name": "Social link",
            "settings": [
                {
                    "type": "text",
                    "id": "label",
                    "label": "Network name",
                    "default": ""
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Profile URL",
                    "default": "https://www.instagram.com/"
                }
            ]
        },
        {
            "type": "payment",
            "name": "Payment label",
            "settings": [
                {
                    "type": "text",
                    "id": "label",
                    "label": "Label",
                    "default": ""
                },
                {
                    "type": "image",
                    "id": "image",
                    "label": "Payment logo"
                }
            ]
        }
