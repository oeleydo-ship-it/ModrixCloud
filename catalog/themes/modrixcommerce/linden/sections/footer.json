{
    "name": "Footer",
    "settings": [
        {
            "type": "select",
            "id": "menu_source",
            "label": "Footer menus",
            "options": [
                {
                    "value": "auto",
                    "label": "Admin → Navigation once saved, else theme links"
                },
                {
                    "value": "store",
                    "label": "Always Admin → Navigation"
                },
                {
                    "value": "theme",
                    "label": "Theme links only"
                }
            ],
            "default": "auto"
        },
        {
            "type": "text",
            "id": "newsletter_heading",
            "label": "Newsletter heading",
            "default": "Get exclusive offers delivered to your inbox"
        },
        {
            "type": "text",
            "id": "copyright",
            "label": "Copyright",
            "default": "Linden & Vale. All rights reserved."
        },
        {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "foreground",
            "label": "Headings and text",
            "default": "#222222"
        },
        {
            "type": "color",
            "id": "muted",
            "label": "Secondary text",
            "default": "#777777"
        },
        {
            "type": "checkbox",
            "id": "show_top",
            "label": "Show Back to top",
            "default": true
        },
        {
            "type": "image",
            "id": "qr_image",
            "label": "Optional store QR image"
        },
        {
            "type": "text",
