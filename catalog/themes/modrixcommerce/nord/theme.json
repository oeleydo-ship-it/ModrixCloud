{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "modrixcommerce/nord",
    "display_name": "Nord",
    "description": "The NORD MagicPath reference: full fashion campaigns, editorial collections, six-card product rails, responsive catalog and product gallery, styled core bag and checkout, and extensible storefront slots.",
    "version": "1.0.1",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "capabilities": ["home.sections", "demo_content"],
    "assets": "assets",
    "screenshot": "assets/demo-preview.png",
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#191a1b",
        "color.primary": "#191a1b",
        "color.primary_foreground": "#ffffff",
        "color.muted": "#f0f3f5",
        "color.muted_foreground": "#555555",
        "color.accent": "#ef373b",
        "color.accent_foreground": "#ffffff",
        "color.border": "#d2d6d8",
        "font_body": "sans",
        "font_heading": "sans",
        "radius": "0",
        "density": "spacious",
        "container": "wide",
        "layout.header": "classic",
        "layout.footer": "columns",
        "layout.product_card": "minimal",
        "layout.grid_columns": "4",
        "layout.product_page": "split",
        "menu_1_label": "New & Now",
        "menu_1_link": "/search",
        "menu_2_label": "Women",
        "menu_2_link": "/search",
        "menu_3_label": "Men",
        "menu_3_link": "/search",
        "menu_4_label": "Beauty",
        "menu_4_link": "/search",
        "menu_5_label": "Shoes",
        "menu_5_link": "/search",
        "menu_6_label": "Accessories",
        "menu_6_link": "/search",
        "menu_7_label": "Kids",
        "menu_7_link": "/search",
        "menu_8_label": "Designer",
        "menu_8_link": "/search",
        "menu_9_label": "Home",
        "menu_9_link": "/search",
        "menu_10_label": "Gifts",
        "menu_10_link": "/search",
        "menu_11_label": "Sale",
        "menu_11_link": "/search",
        "menu_12_label": "Services",
        "menu_12_link": "/account",
        "footer_1_title": "Customer Service",
        "footer_2_title": "About Us",
        "footer_3_title": "Stores & Services",
        "footer_1_1_label": "My orders",
        "footer_1_1_link": "/account/orders",
        "footer_1_2_label": "My account",
        "footer_1_2_link": "/account",
        "footer_1_3_label": "Browse products",
        "footer_1_3_link": "/search",
        "footer_2_1_label": "New arrivals",
        "footer_2_1_link": "/search?sort=newest",
        "footer_2_2_label": "All products",
        "footer_2_2_link": "/search",
        "footer_3_1_label": "Account services",
        "footer_3_1_link": "/account",
        "footer_3_2_label": "Address book",
        "footer_3_2_link": "/account/addresses"
    },
    "customizer_file": "settings.json",
    "frontend": {
        "header": "src/header.tsx",
        "footer": "src/footer.tsx",
        "index": "src/index.tsx",
        "catalog": "src/catalog.tsx",
        "product": "src/product.tsx",
        "cart": "src/cart.tsx",
        "stylesheet": "src/style.css"
    },
    "sections": {
        "home": [
            {
                "type": "featured_products",
                "settings": {
                    "title": "Top Picks for You",
                    "source": "latest",
                    "limit": 6
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Top Sale Picks for You",
                    "source": "featured",
                    "limit": 6
                }
            }
        ]
    },
    "demo_content": "demo.json",
    "changelog": [
        {
            "version": "1.0.0",
            "date": "2026-10-17",
            "notes": "Responsive NORD reference theme with full storefront layouts and platform extension support."
        },
        {
            "version": "1.0.1",
            "date": "2026-10-17",
            "notes": "Homepage campaigns and editorials appear in the customizer Homepage tab."
        }
    ]
}
