{
    "title": "Nord storefront",
    "description": "Customize the reference campaigns, images and page layouts. Shared navigation, products, currencies and extensions come from Modrix Commerce.",
    "hide_core_fields": [
        "layout.header",
        "layout.footer",
        "layout.product_card",
        "layout.product_page",
        "layout.grid_columns",
        "container"
    ],
    "fields": {
        "custom.brand": {
            "type": "string",
            "label": "Wordmark",
            "group": "Header",
            "default": "NORD",
            "max": 60
        },
        "custom.logo_image": {
            "type": "image",
            "label": "Logo upload",
            "group": "Header",
            "default": ""
        },
        "custom.notice": {
            "type": "string",
            "label": "Announcement",
            "group": "Header",
            "default": "Shopping internationally?",
            "max": 160
        },
        "custom.notice_link_label": {
            "type": "string",
            "label": "Announcement link label",
            "group": "Header",
            "default": "Learn About International Shopping",
            "max": 100
        },
        "custom.notice_link": {
            "type": "link",
            "label": "Announcement link",
            "group": "Header",
            "default": "/account/orders"
        },
        "custom.search_placeholder": {
            "type": "string",
            "label": "Search placeholder",
            "group": "Header",
            "default": "Search for products or brands",
            "max": 100
        },
        "custom.show_notice": {
            "type": "boolean",
            "label": "Show announcement",
            "group": "Header",
            "default": true
        },
        "custom.sticky_header": {
            "type": "boolean",
            "label": "Sticky header",
            "group": "Header",
            "default": false
        },
        "custom.show_saved": {
            "type": "boolean",
            "label": "Save products on this device",
            "group": "Product cards",
            "default": true
        },
        "custom.show_buy_button": {
            "type": "boolean",
            "label": "Show optional Buy now actions",
            "group": "Product cards",
            "default": false
        },
        "custom.sticky_add_to_cart": {
            "type": "boolean",
            "label": "Sticky purchase bar on phones",
            "group": "Product",
            "default": true
        },
        "custom.section_gap": {
            "type": "integer",
            "label": "Section spacing (px)",
            "group": "Layout",
            "default": 64,
            "min": 24,
            "max": 100
        },
        "custom.page_width": {
            "type": "integer",
            "label": "Maximum page width (px)",
            "group": "Layout",
            "default": 1920,
            "min": 1000,
            "max": 2000
