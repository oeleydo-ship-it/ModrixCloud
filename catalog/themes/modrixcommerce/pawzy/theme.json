{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "modrixcommerce/pawzy",
    "display_name": "Pawzy",
    "description": "A playful pet shop with navy navigation, yellow accents, pet collections, editorial campaigns and a complete package-owned customizer.",
    "version": "1.0.0",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "capabilities": ["home.sections", "custom_fonts", "demo_content"],
    "assets": "assets",
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#263344",
        "color.primary": "#ffd400",
        "color.primary_foreground": "#263344",
        "color.muted": "#f3f3f3",
        "color.muted_foreground": "#737780",
        "color.accent": "#f7f3f7",
        "color.accent_foreground": "#263344",
        "color.border": "#ececee",
        "color.search": "#ffd400",
        "color.sale": "#ef6749",
        "font_body": "custom:Manrope",
        "font_heading": "custom:Manrope",
        "radius": "0.375rem",
        "density": "spacious",
        "container": "reference",
        "layout.header": "electronics",
        "layout.footer": "columns",
        "layout.product_card": "electronics",
        "layout.grid_columns": "4",
        "layout.product_page": "split",
        "announcement": "Free shipping on orders over $100!",
        "footer_text": "\u00c2\u00a9 Pawzy. All rights reserved.",
        "style.general.body_size": "14",
        "style.general.heading_weight": "800",
        "contact_email": "",
        "contact_phone": "",
        "menu_1_label": "Home",
        "menu_1_link": "/",
        "menu_2_label": "Collections",
        "menu_2_link": "/c/pawzy-cats",
        "menu_3_label": "Products",
        "menu_3_link": "/search",
        "menu_4_label": "Our story",
        "menu_4_link": "/pages/pawzy-our-story",
        "menu_5_label": "Pet journal",
        "menu_5_link": "/pages/pawzy-pet-journal",
        "footer_1_title": "My account",
        "footer_1_1_label": "Login / Register",
        "footer_1_1_link": "/account",
        "footer_1_2_label": "View your orders",
        "footer_1_2_link": "/account/orders",
        "footer_1_3_label": "Shop all products",
        "footer_1_3_link": "/search",
        "footer_2_title": "Information",
        "footer_2_1_label": "Our story",
        "footer_2_1_link": "/pages/pawzy-our-story",
        "footer_2_2_label": "Pet journal",
        "footer_2_2_link": "/pages/pawzy-pet-journal",
        "footer_2_3_label": "Shipping & delivery",
        "footer_2_3_link": "/pages/pawzy-shipping",
        "footer_3_title": "Our policies",
        "footer_3_1_label": "Order & payment",
        "footer_3_1_link": "/pages/pawzy-payments",
        "footer_3_2_label": "Returns & exchanges",
        "footer_3_2_link": "/pages/pawzy-returns",
        "footer_3_3_label": "Privacy policy",
        "footer_3_3_link": "/pages/pawzy-privacy"
    },
    "fonts": [
        {
            "family": "Manrope",
            "file": "assets/fonts/manrope-latin.woff2",
            "weight": "400 800",
            "style": "normal"
        }
    ],
    "sections": {
        "home": [
            {
                "type": "campaign",
                "settings": {
                    "heading": "Smiles, Wags, And Love",
                    "image": "asset:assets/images/hero.jpg",
                    "background": "#ef90b5",
                    "foreground": "#263344",
                    "eyebrow": "Pet picks",
                    "body": "Everything they love. Everything they need. Find a little joy for every paw.",
                    "button_label": "Shop now",
                    "button_link": "/search",
                    "height": "large"
                }
            },
            {
                "type": "promotion_grid",
                "settings": {
                    "title": "",
                    "style": "service",
                    "columns": "4",
                    "tile_1_title": "Return policy",
                    "tile_1_image": "",
                    "tile_1_link": "/pages/pawzy-returns",
                    "tile_1_text": "Here to help with your order.",
                    "tile_2_title": "Delivery options",
                    "tile_2_image": "",
                    "tile_2_link": "/pages/pawzy-shipping",
