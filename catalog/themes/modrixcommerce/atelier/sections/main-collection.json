{
    "name": "Editorial catalog and filters",
    "enabled_on": {
        "templates": ["collection", "search"]
    },
    "settings": [
        {
            "type": "checkbox",
            "id": "show_banner",
            "label": "Show top catalog banner",
            "default": true
        },
        {
            "type": "image",
            "id": "banner_image",
            "label": "Banner photograph",
            "default": "asset:assets/hero.jpg"
        },
        {
            "type": "range",
            "id": "banner_height",
            "label": "Banner height (px)",
            "default": 280,
            "min": 160,
            "max": 500,
            "step": 10
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Default catalog heading",
            "default": "Explore all"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Default catalog description",
            "default": "Considered essentials with a lasting point of view."
        },
        {
            "type": "select",
            "id": "columns",
            "label": "Desktop product columns",
            "default": "4",
            "options": [
                {
                    "value": "3",
                    "label": "3 columns"
                },
                {
                    "value": "4",
                    "label": "4 columns"
                }
            ]
        },
        {
            "type": "checkbox",
            "id": "show_filters",
            "label": "Enable filters drawer",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_sort",
            "label": "Show sort options",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_categories",
            "label": "Filter by category",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_brands",
            "label": "Filter by brand",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_price",
            "label": "Filter by price",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_stock",
            "label": "Filter by availability",
            "default": true
        }
    ]
}
