{
    "title": "Vellaro storefront",
    "description": "Independent Vellaro settings. Upload an image for every campaign and collection tile. Menus, products, attributes, stock, payments and enabled extensions come from the platform.",
    "hide_core_fields": [
        "layout.header",
        "layout.footer",
        "layout.product_card",
        "layout.product_page",
        "layout.grid_columns",
        "announcement",
        "container",
        "logo",
        "footer_text"
