        },
        "custom.notice_color": {
            "type": "color",
            "label": "Announcement background",
            "group": "Header",
            "default": "#181616"
        },
        "custom.show_notice": {
            "type": "boolean",
            "label": "Show announcement",
            "group": "Header",
            "default": true
        },
        "custom.header_benefit_1": {
            "type": "string",
            "label": "Benefit 1",
