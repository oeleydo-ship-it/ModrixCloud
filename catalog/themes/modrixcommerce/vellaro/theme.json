{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "modrixcommerce/vellaro",
    "display_name": "Vellaro Fashion",
    "description": "Monochrome fashion storefront from the MagicPath Vellaro reference. Campaign banners, editorial collections, five-product rows and a four-column catalog, connected to platform commerce.",
    "version": "1.0.0",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "capabilities": ["home.sections", "demo_content"],
    "assets": "assets",
    "screenshot": "assets/demo-preview.png",
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#181616",
        "color.primary": "#181616",
        "color.primary_foreground": "#ffffff",
        "color.muted": "#f5f5f5",
        "color.muted_foreground": "#6b6b6b",
        "color.accent": "#0085a5",
        "color.accent_foreground": "#ffffff",
        "color.border": "#e5e5e5",
        "font_body": "system",
        "font_heading": "system",
        "radius": "0",
        "density": "compact",
        "container": "wide",
        "layout.header": "centered",
        "layout.footer": "columns",
        "layout.product_card": "minimal",
        "layout.grid_columns": "4",
        "layout.product_page": "split",
        "footer_text": "Everyday, better.",
        "menu_1_label": "Sale",
        "menu_1_link": "/search",
        "menu_2_label": "Web exclusives",
        "menu_2_link": "/search",
        "menu_3_label": "New arrivals",
        "menu_3_link": "/search?sort=newest",
        "menu_4_label": "Women",
        "menu_4_link": "/search",
        "menu_5_label": "Men",
        "menu_5_link": "/search",
        "menu_6_label": "Junior",
        "menu_6_link": "/search",
        "footer_1_title": "Women",
        "footer_1_1_label": "New",
        "footer_1_1_link": "/search?sort=newest",
        "footer_1_2_label": "Products",
        "footer_1_2_link": "/search",
        "footer_1_3_label": "Rooms",
        "footer_1_3_link": "/search",
        "footer_1_4_label": "Collections",
        "footer_1_4_link": "/search",
        "footer_2_title": "Men",
        "footer_2_1_label": "Payment",
        "footer_2_1_link": "/account/orders",
        "footer_2_2_label": "Delivery",
        "footer_2_2_link": "/account/orders",
        "footer_2_3_label": "Returns and exchanges",
        "footer_2_3_link": "/account/orders",
        "footer_2_4_label": "Warranty and service",
        "footer_2_4_link": "/account",
        "footer_3_title": "Help",
        "footer_3_1_label": "About company",
        "footer_3_1_link": "/",
        "footer_3_2_label": "Contacts",
        "footer_3_2_link": "/account",
        "footer_3_3_label": "B2B",
        "footer_3_3_link": "/account",
        "menu_7_label": "Shoes",
        "menu_7_link": "/search"
    },
    "customizer_file": "settings.json",
    "frontend": {
        "header": "src/header.tsx",
        "footer": "src/footer.tsx",
        "index": "src/index.tsx",
        "catalog": "src/catalog.tsx",
        "product": "src/product.tsx",
        "cart": "src/cart.tsx",
        "stylesheet": "src/style.css"
    },
    "sections": {
        "home": [
            {
                "type": "featured_products",
                "settings": {
                    "title": "New arrivals",
                    "source": "latest",
                    "limit": 5
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Summer essentials",
                    "source": "latest",
                    "limit": 5
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Fresh fits. Only found online.",
                    "source": "latest",
                    "limit": 5
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Trending",
                    "source": "latest",
                    "limit": 5
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Trending category",
                    "source": "latest",
                    "limit": 5
                }
            }
        ]
    },
    "demo_content": "demo.json"
}
