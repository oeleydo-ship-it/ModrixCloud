{
    "title": "Hearth storefront",
    "description": "Independent Hearth settings for every storefront area. Upload images directly into each image field, then save. Product data, prices, menus and checkout come from your platform.",
    "hide_core_fields": [
        "layout.header",
        "layout.footer",
        "layout.product_card",
        "layout.product_page",
        "layout.grid_columns",
        "announcement",
        "container",
        "logo",
        "footer_text"
