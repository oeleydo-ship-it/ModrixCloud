{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "modrixcommerce/hearth",
    "display_name": "Hearth Home",
    "description": "Furniture storefront adapted from your Hearth MagicPath reference. Sky-blue announcement, centered wordmark, navy serif headings, spacious editorial sections and theme-owned storefront files.",
    "version": "1.0.1",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "capabilities": [
        "home.sections",
        "demo_content"
    ],
    "assets": "assets",
    "screenshot": "assets/demo-preview.png",
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#002b45",
        "color.primary": "#002b45",
        "color.primary_foreground": "#ffffff",
        "color.muted": "#faf7f2",
        "color.muted_foreground": "#7b8992",
        "color.accent": "#c7e7fc",
        "color.accent_foreground": "#002b45",
        "color.border": "#e4e8ed",
        "font_body": "system",
        "font_heading": "serif",
        "radius": "0",
        "density": "spacious",
        "container": "wide",
        "layout.header": "centered",
        "layout.footer": "columns",
        "layout.product_card": "minimal",
        "layout.grid_columns": "3",
        "layout.product_page": "split",
        "footer_text": "A home for thoughtful living",
        "menu_1_label": "Showrooms",
        "menu_1_link": "/search",
        "menu_2_label": "Hearth is home",
        "menu_2_link": "/",
        "menu_3_label": "Ideas",
        "menu_3_link": "/search",
        "menu_4_label": "How to order",
        "menu_4_link": "/account/orders",
        "menu_5_label": "B2B",
        "menu_5_link": "/account",
        "menu_6_label": "Contacts",
        "menu_6_link": "/account",
        "footer_1_title": "Catalogue",
        "footer_1_1_label": "New",
        "footer_1_1_link": "/search?sort=newest",
        "footer_1_2_label": "Products",
        "footer_1_2_link": "/search",
        "footer_1_3_label": "Rooms",
        "footer_1_3_link": "/search",
        "footer_1_4_label": "Collections",
        "footer_1_4_link": "/search",
        "footer_2_title": "How to order",
        "footer_2_1_label": "Payment",
        "footer_2_1_link": "/account/orders",
        "footer_2_2_label": "Delivery",
        "footer_2_2_link": "/account/orders",
        "footer_2_3_label": "Returns and exchanges",
        "footer_2_3_link": "/account/orders",
        "footer_2_4_label": "Warranty and service",
        "footer_2_4_link": "/account",
        "footer_3_title": "About",
        "footer_3_1_label": "About company",
        "footer_3_1_link": "/",
        "footer_3_2_label": "Contacts",
        "footer_3_2_link": "/account",
        "footer_3_3_label": "B2B",
        "footer_3_3_link": "/account"
    },
    "customizer_file": "settings.json",
    "frontend": {
        "header": "src/header.tsx",
        "footer": "src/footer.tsx",
        "index": "src/index.tsx",
        "catalog": "src/catalog.tsx",
        "product": "src/product.tsx",
        "cart": "src/cart.tsx",
        "stylesheet": "src/style.css"
    },
    "sections": {
        "home": [
            {
                "type": "category_grid",
                "settings": {
                    "title": "Products · Rooms · Styles",
                    "limit": 7
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Trending",
                    "source": "featured",
                    "limit": 5
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "New in",
                    "source": "latest",
                    "limit": 5
                }
            }
        ]
    },
    "demo_content": "demo.json"
}
