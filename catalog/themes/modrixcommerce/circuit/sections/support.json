{
    "name": "Support banner",
    "enabled_on": {
        "templates": ["*"]
    },
    "settings": [
        {
            "type": "text",
            "id": "support_eyebrow",
            "label": "Eyebrow",
            "default": "Help center"
        },
        {
            "type": "text",
            "id": "support_heading",
            "label": "Heading",
            "default": "Online Support 24/7"
        },
        {
            "type": "text",
            "id": "trusted_text",
