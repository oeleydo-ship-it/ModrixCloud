        {
            "type": "text",
            "id": "filter_heading",
            "label": "Filter heading",
            "default": "Filter"
        },
        {
            "type": "text",
            "id": "category_filter_label",
            "label": "Categories filter",
            "default": "Products Category"
        },
        {
            "type": "text",
            "id": "availability_label",
            "label": "Availability filter",
            "default": "Availability"
        },
        {
            "type": "text",
            "id": "in_stock_label",
            "label": "In stock option",
            "default": "In stock"
        },
        {
            "type": "text",
            "id": "price_label",
            "label": "Price filter",
            "default": "Price"
        },
        {
            "type": "text",
            "id": "brand_filter_label",
            "label": "Brand filter",
            "default": "Brand"
        },
        {
            "type": "text",
            "id": "all_brands_label",
            "label": "All brands option",
            "default": "All brands"
        },
        {
            "type": "text",
            "id": "apply_filters_label",
            "label": "Apply button",
            "default": "Apply filters"
        },
        {
            "type": "text",
            "id": "clear_all_label",
            "label": "Clear all link",
            "default": "Clear all filters"
        },
        {
            "type": "header",
            "content": "Sorting"
        },
        {
            "type": "text",
            "id": "sort_label",
            "label": "Sort label",
            "default": "Sort by:"
        },
        {
            "type": "text",
            "id": "sort_newest",
            "label": "Newest",
            "default": "Newest"
        },
        {
            "type": "text",
            "id": "sort_price_asc",
            "label": "Price low to high",
            "default": "Price: low to high"
        },
        {
            "type": "text",
            "id": "sort_price_desc",
            "label": "Price high to low",
            "default": "Price: high to low"
        },
        {
            "type": "text",
            "id": "sort_name",
            "label": "Name",
            "default": "Name"
