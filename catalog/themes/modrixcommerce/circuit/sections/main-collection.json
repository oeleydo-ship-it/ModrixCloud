        {
            "type": "text",
            "id": "empty_heading",
            "label": "Heading",
            "default": "No products found"
        },
        {
            "type": "text",
            "id": "empty_text",
            "label": "Text",
            "default": "Try another search or change your filters."
        },
        {
            "type": "text",
            "id": "clear_label",
            "label": "Clear filters button",
            "default": "Clear filters"
        },
        {
            "type": "text",
            "id": "browse_label",
            "label": "Browse link",
            "default": "Browse all products"
        },
        {
            "type": "header",
            "content": "Breadcrumb"
        },
        {
            "type": "text",
            "id": "home_label",
            "label": "Home link label",
            "default": "Home"
        }
