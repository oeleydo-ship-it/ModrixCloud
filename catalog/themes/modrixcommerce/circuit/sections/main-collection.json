{
    "name": "Product grid",
    "enabled_on": {
        "templates": ["collection", "search"]
    },
    "limit": 1,
    "settings": [
        {
            "type": "select",
            "id": "catalog_grid",
            "label": "Default grid",
            "options": [
                {
                    "value": "2",
                    "label": "2"
                },
                {
                    "value": "3",
                    "label": "3"
                },
                {
                    "value": "4",
                    "label": "4"
                },
                {
                    "value": "list",
                    "label": "List"
                }
            ],
            "default": "3"
        },
        {
            "type": "header",
            "content": "Coupon card"
        },
        {
            "type": "checkbox",
            "id": "coupon_show",
            "label": "Show the coupon card under the filters",
            "default": true
        },
        {
            "type": "text",
            "id": "coupon_eyebrow",
            "label": "Coupon card eyebrow",
            "default": "Top sale"
        },
        {
            "type": "text",
            "id": "coupon_heading",
            "label": "Coupon card heading",
            "default": "Here's Your 15% Coupon"
        },
        {
            "type": "image",
            "id": "coupon_image",
            "label": "Coupon card image",
            "default": "asset:assets/coupon-card.jpg"
