{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "modrixcommerce/circuit",
    "display_name": "Circuit Market",
    "description": "Electronics megastore theme: navy header with a rounded search, category rail, hero mosaic, deal countdown, promo mosaics, filters, a detailed product page and an editable footer. Every text, image, color and link is in the customizer.",
    "version": "1.3.0",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "capabilities": [
        "custom_fonts",
        "demo_content",
        "home.sections",
        "sections"
    ],
    "assets": "assets",
    "screenshot": "assets/demo-preview.png",
    "fonts": [
        {
            "family": "Instrument Sans",
            "file": "assets/instrument-sans.woff2",
            "weight": "400 700",
            "style": "normal"
        }
    ],
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#111111",
        "color.primary": "#111111",
        "color.primary_foreground": "#ffffff",
        "color.muted": "#f4f4f6",
        "color.muted_foreground": "#6b6b76",
        "color.accent": "#e5484d",
        "color.accent_foreground": "#ffffff",
        "color.border": "#e8e8ec",
        "font_body": "custom:Instrument Sans",
        "font_heading": "custom:Instrument Sans",
        "radius": "0.5rem",
        "density": "compact",
        "container": "wide",
        "layout.header": "classic",
        "layout.footer": "columns",
        "layout.product_card": "minimal",
        "layout.grid_columns": "4",
        "layout.product_page": "split",
        "menu_1_label": "Home",
        "menu_1_link": "/",
        "menu_2_label": "Shop",
        "menu_2_link": "/search",
        "menu_3_label": "Laptops",
        "menu_3_link": "/search?q=laptop",
        "menu_4_label": "Phones",
        "menu_4_link": "/search?q=phone",
        "menu_5_label": "Audio",
        "menu_5_link": "/search?q=audio",
        "menu_6_label": "Sale",
        "menu_6_link": "/search?sort=price_asc",
        "footer_1_title": "Our Company",
        "footer_1_1_label": "About us",
        "footer_1_1_link": "/search",
        "footer_1_2_label": "Contact us",
        "footer_1_2_link": "/account",
        "footer_1_3_label": "Sale",
        "footer_1_3_link": "/search?sort=price_asc",
        "footer_1_4_label": "Our store",
        "footer_1_4_link": "/search",
        "footer_1_5_label": "FAQ",
        "footer_1_5_link": "/account",
        "footer_2_title": "Shop Categories",
        "footer_2_1_label": "Laptops",
        "footer_2_1_link": "/search?q=laptop",
        "footer_2_2_label": "Phones",
        "footer_2_2_link": "/search?q=phone",
        "footer_2_3_label": "Tablets",
        "footer_2_3_link": "/search?q=tablet",
        "footer_2_4_label": "Audio",
        "footer_2_4_link": "/search?q=audio",
        "footer_2_5_label": "Cameras",
        "footer_2_5_link": "/search?q=camera",
        "footer_2_6_label": "Smart home",
        "footer_2_6_link": "/search?q=home"
    },
    "customizer_file": "settings.json",
    "frontend": {
        "customizer": "src/customizer.tsx",
        "header": "src/header.tsx",
        "footer": "src/footer.tsx",
        "index": "src/index.tsx",
        "catalog": "src/catalog.tsx",
        "product": "src/product.tsx",
        "cart": "src/cart.tsx",
        "stylesheet": "src/style.css"
    },
    "sections": {
        "home": [
            {
                "type": "campaign",
                "settings": {
                    "eyebrow": "Buy 1 get 1 watch",
                    "heading": "Save! 30-50%",
                    "body": "Starting at $175. Hurry up! Do not miss out.",
                    "image": "asset:assets/hero-watch.jpg",
                    "background": "#1c2a24",
                    "foreground": "#ffffff",
                    "height": "large",
                    "button_label": "Shop Sale",
                    "button_link": "/search?sort=price_asc"
                }
            },
            {
                "type": "campaign",
                "settings": {
                    "eyebrow": "New arrivals",
                    "heading": "Colour your screen",
                    "body": "Laptops with vivid displays, from $499.",
                    "image": "asset:assets/cat-laptop.jpg",
                    "background": "#160f24",
                    "foreground": "#ffffff",
                    "height": "large",
                    "button_label": "Shop Laptops",
                    "button_link": "/search?q=laptop"
                }
            },
            {
                "type": "campaign",
                "settings": {
                    "eyebrow": "Save 30-60% electronics",
                    "heading": "Toaster ovens save up to $159",
                    "body": "",
                    "image": "asset:assets/tile-kitchen.jpg",
                    "background": "#b9937a",
                    "foreground": "#ffffff",
                    "height": "medium",
                    "button_label": "Shop Now",
                    "button_link": "/search?q=kitchen"
                }
            },
            {
                "type": "campaign",
                "settings": {
                    "eyebrow": "Audio brand",
                    "heading": "Buy 1 Get 1 Earbuds",
                    "body": "Starting at $135",
                    "image": "asset:assets/tile-earbuds.jpg",
                    "background": "#14111f",
                    "foreground": "#ffffff",
                    "height": "small",
                    "button_label": "",
                    "button_link": "/search?q=earbuds"
                }
            },
            {
                "type": "campaign",
                "settings": {
                    "eyebrow": "Studio sound",
                    "heading": "Sale 30% Headphones",
                    "body": "Starting at $95",
                    "image": "asset:assets/tile-headphones.jpg",
                    "background": "#0d0d12",
                    "foreground": "#ffffff",
                    "height": "small",
                    "button_label": "",
                    "button_link": "/search?q=headphones"
                }
            },
            {
                "type": "promotion_grid",
                "settings": {
                    "title": "",
                    "columns": "8",
                    "style": "circle",
                    "wrap": true,
                    "tile_1_title": "Daily Deals",
                    "tile_1_text": "Daily deals",
                    "tile_1_link": "/search?sort=price_asc",
                    "tile_2_title": "Laptops/PCs",
                    "tile_2_image": "asset:assets/cat-laptop.jpg",
                    "tile_2_link": "/search?q=laptop",
                    "tile_3_title": "Phone/Mobile",
                    "tile_3_image": "asset:assets/cat-phone.jpg",
                    "tile_3_link": "/search?q=phone",
                    "tile_4_title": "Tablets",
                    "tile_4_image": "asset:assets/cat-tablet.jpg",
                    "tile_4_link": "/search?q=tablet",
                    "tile_5_title": "Camera/Photo",
                    "tile_5_image": "asset:assets/cat-camera.jpg",
                    "tile_5_link": "/search?q=camera",
                    "tile_6_title": "Home/Electronics",
                    "tile_6_image": "asset:assets/cat-home.jpg",
                    "tile_6_link": "/search?q=home",
                    "tile_7_title": "Clearance Sale",
                    "tile_7_text": "Big sale",
                    "tile_7_link": "/search?sort=price_asc",
                    "tile_8_title": "Sale 50% Off",
                    "tile_8_text": "Sale 50",
                    "tile_8_link": "/search?sort=price_asc"
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Today's Best Deals",
                    "source": "latest",
                    "limit": 5
                }
            },
            {
                "type": "promo_banner",
                "settings": {
                    "text": "Big Promotion Grab Your Vouchers!",
                    "subtext": "Up to 35% off everything with this code. Limited time only. Excludes selected lines.",
                    "button_label": "Shop Sale",
                    "button_link": "/search?sort=price_asc",
                    "tone": "primary"
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Popular Picks",
                    "source": "featured",
                    "limit": 4
                }
            },
            {
                "type": "promotion_grid",
                "settings": {
                    "title": "",
                    "columns": "4",
                    "style": "editorial",
                    "wrap": true,
                    "tile_1_title": "Laptops from $1,579",
                    "tile_1_text": "Pro series",
                    "tile_1_image": "asset:assets/promo-laptop.jpg",
                    "tile_1_link": "/search?q=laptop",
                    "tile_2_title": "Limited Edition",
                    "tile_2_text": "Save 30-60% electronics",
                    "tile_2_image": "asset:assets/promo-appliance.jpg",
                    "tile_2_link": "/search?q=kitchen",
                    "tile_3_title": "Speaker save up to $178",
                    "tile_3_text": "Limited time: online only",
                    "tile_3_image": "asset:assets/promo-speaker.jpg",
                    "tile_3_link": "/search?q=speaker",
                    "tile_4_title": "Limited Edition",
                    "tile_4_text": "Choose the right laptop screen for the best experience.",
                    "tile_4_image": "asset:assets/promo-limited.jpg",
                    "tile_4_link": "/search?q=laptop"
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "Best Selling",
                    "source": "latest",
                    "limit": 5
                }
            },
            {
                "type": "promotion_grid",
                "settings": {
                    "title": "Featured Brands",
                    "columns": "5",
                    "style": "plain",
                    "wrap": true,
                    "tile_1_title": "Northwave",
                    "tile_1_link": "/search?q=northwave",
                    "tile_2_title": "LUMIO",
                    "tile_2_link": "/search?q=lumio",
                    "tile_3_title": "Aerotek",
                    "tile_3_link": "/search?q=aerotek",
                    "tile_4_title": "PIXELON",
                    "tile_4_link": "/search?q=pixelon",
                    "tile_5_title": "Soundcraft",
                    "tile_5_link": "/search?q=soundcraft"
                }
            },
            {
                "type": "image_with_text",
                "settings": {
                    "heading": "Small Size Big Sound",
                    "body": "A mini speaker with powerful and dynamic sound. Compact and portable, perfect for any space and easy to carry anywhere.",
                    "image": "asset:assets/spotlight-speaker.jpg",
                    "image_position": "left",
                    "button_label": "Portable wireless speakers",
                    "button_link": "/search?q=speaker"
                }
            }
        ]
    },
    "demo_content": "demo.json",
    "changelog": [
        {
            "version": "1.3.0",
            "date": "2026-10-23",
            "notes": "Everything on every page is editable in the theme editor: content and labels moved from theme settings onto their sections; announcements, top links, services, support cards and delivery lines are blocks. Theme settings keep only colors and button shape."
        },
        {
            "version": "1.2.0",
            "date": "2026-10-23",
            "notes": "Every page is built from sections: edit the header, footer, home, product, collection, search, cart and page templates in the theme editor with live preview."
        },
        {
            "version": "1.1.0",
            "date": "2026-10-20",
            "notes": "Adds a package-owned Circuit theme studio with reusable platform save, image, section and extension controls."
        },
        {
            "version": "1.0.0",
            "date": "2026-10-18",
            "notes": "Circuit electronics theme: header with category rail and recently viewed products, homepage mosaic and deal countdown, catalog filters, detailed product page, cart and footer, all editable in the customizer."
        }
    ]
}
