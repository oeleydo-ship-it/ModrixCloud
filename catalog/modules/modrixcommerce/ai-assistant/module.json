{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/ai-assistant",
    "display_name": "AI Content Assistant",
    "description": "Product writing and catalog translation with configurable OpenAI, Kimi and DeepSeek APIs. The extension is free; provider usage follows your API account plan.",
    "version": "1.2.0",
    "type": "module",
    "icon": "sparkles",
    "accent": "#7c3aed",
    "platform_version": "^0.4 || ^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\AiAssistant\\": "src/"
        }
    },
    "provider": "EcoModular\\AiAssistant\\AiAssistantServiceProvider",
    "capabilities": ["admin.routes", "admin.navigation", "settings"],
    "routes": {
        "admin": "routes/admin.php"
    },
    "settings": [
        {
            "label": "Allow AI suggestions",
            "type": "boolean",
            "key": "enabled",
            "default": true
        },
        {
            "label": "AI provider",
            "type": "select",
            "key": "provider",
            "default": "openai",
            "options": [
                {
                    "label": "OpenAI",
                    "value": "openai"
                },
                {
                    "label": "Kimi (Moonshot)",
                    "value": "kimi"
                },
                {
                    "label": "DeepSeek",
                    "value": "deepseek"
                }
            ]
        },
        {
            "type": "string",
            "key": "openai_model",
            "max_length": 200,
            "required": true,
            "default": "gpt-6-luna",
            "label": "OpenAI model ID",
            "suggestions": [
                "gpt-6-luna",
                "gpt-6.1-sol",
                "gpt-6-astra",
                "gpt-5.6-luna",
                "gpt-5.6-terra",
                "gpt-5.6-sol",
                "gpt-5.5",
                "gpt-5.4-mini",
                "gpt-5-mini"
            ],
            "visible_when": {
                "provider": "openai"
            }
        },
        {
            "label": "OpenAI API mode",
            "type": "select",
            "key": "openai_api",
            "default": "responses",
            "options": [
                {
                    "label": "Responses API",
                    "value": "responses"
                },
                {
                    "label": "Chat Completions",
                    "value": "chat"
                },
                {
                    "label": "Legacy Chat Completions",
                    "value": "legacy_chat"
                }
            ],
            "visible_when": {
                "provider": "openai"
            }
        },
        {
            "type": "string",
            "key": "kimi_model",
            "max_length": 200,
            "required": true,
            "default": "kimi-k3",
            "label": "Kimi model ID",
            "suggestions": ["kimi-k3", "kimi-k2.6"],
            "visible_when": {
                "provider": "kimi"
            }
        },
        {
            "label": "Kimi API mode",
            "type": "select",
            "key": "kimi_api",
            "default": "legacy_chat",
            "options": [
                {
                    "label": "Chat Completions",
                    "value": "chat"
                },
                {
                    "label": "Legacy Chat Completions",
                    "value": "legacy_chat"
                }
            ],
            "visible_when": {
                "provider": "kimi"
            }
        },
        {
            "label": "Kimi account region",
            "type": "select",
            "key": "kimi_region",
            "default": "international",
            "options": [
                {
                    "label": "International (.ai)",
                    "value": "international"
                },
                {
                    "label": "China (.cn)",
                    "value": "china"
                }
            ],
            "visible_when": {
                "provider": "kimi"
            }
        },
        {
            "type": "string",
            "key": "deepseek_model",
            "max_length": 200,
            "required": true,
            "default": "deepseek-flash",
            "label": "DeepSeek model ID",
            "suggestions": ["deepseek-flash", "deepseek-v4-pro"],
            "visible_when": {
                "provider": "deepseek"
            }
        },
        {
            "label": "DeepSeek API mode",
            "type": "select",
            "key": "deepseek_api",
            "default": "legacy_chat",
            "options": [
                {
                    "label": "Chat Completions",
                    "value": "chat"
                },
                {
                    "label": "Legacy Chat Completions",
                    "value": "legacy_chat"
                }
            ],
            "visible_when": {
                "provider": "deepseek"
            }
        },
        {
            "label": "Request JSON output",
            "type": "boolean",
            "key": "json_mode",
            "default": true,
            "help": "Turn off for older models without JSON mode. Text is still validated before applying."
        },
        {
            "type": "integer",
            "key": "max_tokens",
            "min": 256,
            "max": 32768,
            "default": 8192,
            "label": "Maximum output tokens"
        },
        {
            "type": "integer",
            "key": "timeout",
            "min": 10,
            "max": 120,
            "default": 90,
            "label": "Request timeout (seconds)"
        },
        {
            "label": "Default writing tone",
            "type": "select",
            "key": "tone",
            "default": "professional",
            "options": [
                {
                    "label": "Professional",
                    "value": "professional"
                },
                {
                    "label": "Friendly",
                    "value": "friendly"
                },
                {
                    "label": "Concise",
                    "value": "concise"
                }
            ]
        }
    ],
    "admin_navigation": [
        {
            "key": "ai",
            "title": "AI Assistant",
            "route": "index",
            "icon": "sparkles",
            "group": "Configuration",
            "permission": "settings.manage",
            "order": 850
        }
    ]
}
