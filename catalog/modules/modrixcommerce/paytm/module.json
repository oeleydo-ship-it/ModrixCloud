{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/paytm",
    "display_name": "Paytm Payment Gateway",
    "description": "Paytm All-in-One Payment Gateway for India with Paytm UPI, Paytm Wallet, Net Banking, credit/debit cards, and server checksum verification.",
    "version": "1.0.0",
    "type": "module",
    "icon": "wallet",
    "accent": "#00b9f5",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\Paytm\\": "src/"
        }
    },
    "provider": "EcoModular\\Paytm\\PaytmServiceProvider",
    "capabilities": [
        "payment.gateway",
        "admin.routes",
        "admin.navigation",
        "storefront.routes",
        "content_security"
    ],
    "routes": {
        "admin": "routes/admin.php",
        "storefront": "routes/storefront.php"
    },
    "assets": {
        "pages": "resources/js/pages"
    },
    "content_security": {
        "connect-src": [
            "https://securegw.paytm.in",
            "https://securegw-stage.paytm.in",
            "https://securestage.paytmpayments.com"
        ],
        "frame-src": [
            "https://securegw.paytm.in",
            "https://securegw-stage.paytm.in",
            "https://securestage.paytmpayments.com"
        ],
        "form-action": [
            "https://securegw.paytm.in",
            "https://securegw-stage.paytm.in",
            "https://securestage.paytmpayments.com"
        ]
    },
    "admin_navigation": [
        {
            "key": "paytm",
            "title": "Paytm",
            "route": "index",
            "icon": "wallet",
            "group": "Configuration",
            "permission": "payments.manage",
            "order": 874
        }
    ]
}
