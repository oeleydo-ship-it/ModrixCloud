{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/sales-widget",
    "display_name": "Sales Trend Widget",
    "description": "Adds a daily sales chart for recent days to the admin dashboard.",
    "version": "1.0.0",
    "type": "module",
    "icon": "chart-column",
    "accent": "#10b981",
    "platform_version": "^0.4 || ^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\SalesWidget\\": "src/"
        }
    },
    "provider": "EcoModular\\SalesWidget\\SalesWidgetServiceProvider",
    "capabilities": ["dashboard.widgets", "settings"],
    "assets": {
        "slots": "resources/js/slots"
    },
    "settings": [
        {
            "key": "days",
            "type": "integer",
            "label": "Number of days to show",
            "default": 7,
            "min": 7,
            "max": 30
        }
    ]
}
