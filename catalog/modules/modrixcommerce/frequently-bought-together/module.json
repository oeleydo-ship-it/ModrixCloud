{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/frequently-bought-together",
    "display_name": "Frequently Bought Together",
    "description": "Shows a bundle of products that customers often buy together on each product page, learned from real order history. Shoppers tick the extras and add the whole set to the cart in one go.",
    "version": "1.0.1",
    "type": "module",
    "icon": "package-plus",
    "accent": "#6366f1",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\FrequentlyBoughtTogether\\": "src/"
        }
    },
    "provider": "EcoModular\\FrequentlyBoughtTogether\\FrequentlyBoughtTogetherServiceProvider",
    "permissions": [
        {
            "name": "bundles.manage",
            "label": "Manage frequently bought together bundles",
            "group": "Marketing"
        }
    ],
    "capabilities": [
        "admin.routes",
        "admin.navigation",
        "storefront.routes",
        "storefront.slots",
        "settings",
        "permissions"
    ],
    "routes": {
        "admin": "routes/admin.php",
        "storefront": "routes/storefront.php"
    },
    "assets": {
        "pages": "resources/js/pages",
        "slots": "resources/js/slots"
    },
    "settings": [
        {
            "key": "enabled",
            "type": "boolean",
            "label": "Show the bundle on product pages",
            "default": true
        },
        {
            "key": "heading",
            "tab": "product",
            "type": "string",
            "label": "Heading",
            "default": "Frequently bought together"
        },
        {
            "key": "max_products",
            "tab": "product",
            "type": "integer",
            "label": "Products to suggest",
            "help": "How many companion products to offer alongside the one being viewed.",
            "min": 1,
            "max": 4,
            "default": 3
        },
        {
            "key": "min_orders",
            "type": "integer",
            "label": "Minimum co-purchases",
            "help": "A product is only suggested once it has been bought together with this one at least this many times. Lower it to show suggestions sooner; raise it for stronger proof.",
            "min": 1,
            "max": 20,
            "default": 1
        },
        {
            "key": "fallback_related",
            "type": "boolean",
            "label": "Fall back to related products",
            "help": "When there is not enough order history, suggest products from the same category instead of showing nothing.",
            "default": true
        },
        {
            "key": "show_savings",
            "type": "boolean",
            "label": "Show the combined price",
            "help": "Displays the total price of the selected products next to the add-all button.",
            "default": true
        }
    ],
    "admin_navigation": [
        {
            "key": "frequently-bought-together",
            "title": "Frequently Bought Together",
            "route": "index",
            "icon": "package-plus",
            "group": "Marketing",
            "permission": "bundles.manage",
            "order": 330
        }
    ]
}
