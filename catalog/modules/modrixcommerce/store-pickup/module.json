{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/store-pickup",
    "display_name": "Store Pickup & Click & Collect",
    "description": "Allow customers to choose in-store or retail branch pickup instead of home delivery, with branch location management, alternative collector authorization, and order readiness tracking.",
    "version": "1.1.0",
    "type": "module",
    "icon": "map-pin",
    "accent": "#0ea5e9",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\StorePickup\\": "src/"
        }
    },
    "provider": "EcoModular\\StorePickup\\StorePickupServiceProvider",
    "permissions": [
        {
            "name": "store_pickup.manage",
            "label": "Manage store pickup branches, orders, and settings",
            "group": "Operations"
        }
    ],
    "capabilities": [
        "admin.routes",
        "admin.navigation",
        "storefront.routes",
        "storefront.slots",
        "database.migrations",
        "settings",
        "permissions",
        "events.listen",
        "shipping.rates",
        "checkout.validators"
    ],
    "migrations": "database/migrations",
    "routes": {
        "admin": "routes/admin.php",
        "storefront": "routes/storefront.php"
    },
    "assets": {
        "pages": "resources/js/pages",
        "slots": "resources/js/slots"
    },
    "settings": [
        {
            "key": "enabled",
            "type": "boolean",
            "label": "Enable in-store and branch pickup at checkout",
            "default": true
        },
        {
            "key": "shipping_label",
            "type": "string",
            "label": "Pickup Option Label at Checkout",
            "default": "In-Store & Branch Pickup",
            "max_length": 120
        },
        {
            "key": "allow_alternative_collector",
            "type": "boolean",
            "label": "Allow customers to designate an alternative collector",
            "default": true
        },
        {
            "key": "allow_schedule",
            "type": "boolean",
            "label": "Allow customers to schedule preferred pickup date and time",
            "default": true
        },
        {
            "key": "instructions",
            "type": "text",
            "label": "Default pickup instructions shown on receipts",
            "default": "Please bring your Order # and a valid photo ID to collect your items."
        },
        {
            "key": "cod_behavior",
            "type": "string",
            "label": "Cash on Delivery Handling for Store Pickup",
            "default": "pay_in_store"
        },
        {
            "key": "pay_in_store_label",
            "type": "string",
            "label": "Pay in Store Label at Checkout",
            "default": "Pay in store",
            "max_length": 120
        },
        {
            "key": "pay_in_store_instructions",
            "type": "text",
            "label": "Pay in Store Instructions at Checkout",
            "default": "Pay in store (cash or card) when you collect your order."
        }
    ],
    "admin_navigation": [
        {
            "key": "store-pickup",
            "title": "Store Pickup",
            "route": "index",
            "icon": "map-pin",
            "group": "Operations",
            "permission": "store_pickup.manage",
            "order": 430
        }
    ]
}
