{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/order-alerts",
    "display_name": "Paid Order Alerts",
    "description": "Emails a chosen address when an order is paid, optionally only above a minimum total.",
    "version": "1.0.0",
    "type": "module",
    "icon": "bell",
    "accent": "#f97316",
    "platform_version": "^0.4 || ^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\OrderAlerts\\": "src/"
        }
    },
    "provider": "EcoModular\\OrderAlerts\\OrderAlertsServiceProvider",
    "capabilities": [
        "events.listen",
        "notifications",
        "settings",
        "database.migrations"
    ],
    "migrations": "database/migrations",
    "settings": [
        {
            "key": "recipient",
            "type": "email",
            "label": "Send alerts to",
            "help": "Leave empty to pause alerts."
        },
        {
            "key": "minimum_total",
            "type": "integer",
            "label": "Only for orders of at least (whole currency units)",
            "default": 0,
            "min": 0,
            "max": 1000000
        }
    ]
}
