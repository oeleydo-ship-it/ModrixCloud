{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/tamara",
    "display_name": "Tamara: Buy Now, Pay Later",
    "description": "Let customers across the Gulf split payments with Tamara. Adds Tamara at checkout, promo messaging on product and cart pages, webhooks, capture and refunds.",
    "version": "1.0.0",
    "type": "module",
    "icon": "wallet",
    "accent": "#a855f7",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\Tamara\\": "src/"
        }
    },
    "provider": "EcoModular\\Tamara\\TamaraServiceProvider",
    "capabilities": [
        "payment.gateway",
        "storefront.slots",
        "storefront.routes",
        "admin.routes",
        "admin.navigation",
        "settings"
    ],
    "routes": {
        "admin": "routes/admin.php",
        "storefront": "routes/storefront.php"
    },
    "assets": {
        "pages": "resources/js/pages",
        "slots": "resources/js/slots"
    },
    "settings": [
        {
            "key": "product_snippet",
            "tab": "product",
            "type": "boolean",
            "label": "Show Tamara on product pages",
            "help": "The split-payment message and \"Learn more\" pop-up near the price.",
            "default": true
        },
        {
            "key": "cart_snippet",
            "type": "boolean",
            "label": "Show Tamara in the cart",
            "default": true
        },
        {
            "key": "checkout_card",
            "type": "boolean",
            "label": "Show the payment schedule at checkout",
            "help": "Tamara's checkout card under the payment method, with the instalment breakdown.",
            "default": true
        },
        {
            "key": "eligibility_check",
            "type": "boolean",
            "label": "Check order limits before customers choose Tamara",
            "help": "Checks the order total against your Tamara order limits in the background and disables Tamara with the matching message when the order is outside them. Tamara makes the final decision when the order is placed.",
            "default": true
        },
        {
            "key": "inherit_background",
            "type": "boolean",
            "label": "Snippets use the page background",
            "help": "Off: Tamara's white snippet background.",
            "default": false
        },
        {
            "key": "min_amount",
            "type": "integer",
            "label": "Minimum order total for Tamara",
            "help": "In the store currency. 0 for no minimum.",
            "min": 0,
            "max": 1000000,
            "default": 0
        },
        {
            "key": "max_amount",
            "type": "integer",
            "label": "Maximum order total for Tamara",
            "help": "In the store currency. 0 for no maximum.",
            "min": 0,
            "max": 1000000,
            "default": 0
        }
    ],
    "admin_navigation": [
        {
            "key": "tamara",
            "title": "Tamara",
            "route": "index",
            "icon": "credit-card",
            "group": "Configuration",
            "permission": "payments.manage",
            "order": 860
        }
    ]
}
