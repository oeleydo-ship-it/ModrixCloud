{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "modrixcommerce/telr",
    "display_name": "Telr",
    "description": "Accept cards and wallets on Telr's hosted payment page, or in an iframe on your store. Card data stays on Telr, so this store does not need PCI DSS certification for the checkout form.",
    "version": "1.0.0",
    "type": "module",
    "icon": "credit-card",
    "accent": "#0e4c92",
    "platform_version": "^1.0",
    "author": "Modrix team",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\Telr\\": "src/"
        }
    },
    "provider": "EcoModular\\Telr\\TelrServiceProvider",
    "capabilities": [
        "payment.gateway",
        "storefront.routes",
        "admin.routes",
        "admin.navigation",
        "content_security"
    ],
    "routes": {
        "admin": "routes/admin.php",
        "storefront": "routes/storefront.php"
    },
    "assets": {
        "pages": "resources/js/pages"
    },
    "content_security": {
        "frame-src": ["https://secure.telr.com"],
        "connect-src": ["https://secure.telr.com"],
        "form-action": ["https://secure.telr.com"]
    },
    "admin_navigation": [
        {
            "key": "telr",
            "title": "Telr",
            "route": "index",
            "icon": "credit-card",
            "group": "Configuration",
            "permission": "payments.manage",
            "order": 862
        }
    ]
}
